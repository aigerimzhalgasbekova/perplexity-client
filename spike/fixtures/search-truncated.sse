data: {"backend_uuid": "9bf48727-3062-4a4c-998b-d798b74c78c0", "context_uuid": "5bc5dac0-b314-40e9-9fa2-bdc10acf2ad9", "uuid": "93aa05e0-a9b1-4729-ae23-bd4067bf9ad3", "frontend_context_uuid": "a72f0d34-4dd6-42fe-b4aa-ec5ab70a85d2", "display_model": "pplx_pro", "mode": "COPILOT", "search_focus": "internet", "source": "default", "attachments": [], "read_write_token": "REDACTED", "thread_url_slug": "9bf48727-3062-4a4c-998b-d798b74c78c0", "expect_search_results": "true", "gpt4": false, "text_completed": false, "blocks": [{"intended_usage": "web_results", "diff_block": {"field": "web_result_block", "patches": [{"op": "replace", "path": "", "value": {"progress": "IN_PROGRESS", "web_results": [{"name": "Canberra - Wikipedia", "snippet": "", "timestamp": "2001-08-27T00:00:00", "url": "https://en.wikipedia.org/wiki/Canberra", "meta_data": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/2016896b-fa24-50f2-bfe7-41314e0cd9cc/01a84265-e09c-5682-92ce-681c89a1afe2.jpg"]}, "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigational": false, "is_widget": false, "is_focused_web": false, "is_client_context": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false, "trust": {"level": 2, "name": "trusted", "description": "is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge"}}, {"name": "Australia | History, Cities, Population, Capital, Map, & Facts", "snippet": "Australia is the smallest continent and one of the largest countries on Earth, lying between the Pacific and Indian oceans in the Southern Hemisphere. Its capital city is Canberra, and its most important economic and cultural centers are Sydney and Melbourne.", "timestamp": "2026-06-08T00:00:00", "url": "https://www.britannica.com/place/Australia", "meta_data": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/fc7ec0b1-5112-5246-bdc9-af830e2bbf8a/e91e73d4-022b-59db-9713-717a2a198855.jpg"]}, "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigational": false, "is_widget": false, "is_focused_web": false, "is_client_context": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false, "trust": {"level": 2, "name": "trusted", "description": "is trusted for professionally edited general-reference and educational articles across history, science, culture, and other subjects"}}, {"name": "What is the Capital of Australia? - Mappr", "snippet": "The capital of Australia is Canberra. The city is located in the Australian Capital Territory, 150 kilometers inland from the country\u2019s southeast coast.", "timestamp": "2024-03-04T00:00:00", "url": "https://www.mappr.co/capital-cities/australia/", "meta_data": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/bc23429f-9fe3-5ff9-a52e-eec36df5496d/e0fc49c2-5962-580a-acd6-7c74e5ad0f2a.jpg"]}, "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigational": false, "is_widget": false, "is_focused_web": false, "is_client_context": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false}, {"name": "What is the Capital of Australia? Canberra Facts & History - USAnalysis.org", "snippet": "You\u2019ve probably been asked \u201cWhat is the capital of Australia?\u201d more than once. The answer is Canberra \u2014 but the story behind that answer is a fascinating tale of political compromise, rivalries, and a purpose-built city. Official capital: Canberra \u00b7 Population of Canberra (2021): 484,630 \u00b7 Year named capital: 1913 \u00b7 Federal territory: Australian Capital [\u2026]", "timestamp": "2026-07-16T00:00:00", "url": "https://usanalysis.org/blog/what-is-the-capital-of-australia/", "meta_data": {"citation_domain_name": null, "client": "web", "images": []}, "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigational": false, "is_widget": false, "is_focused_web": false, "is_client_context": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false}, {"name": "Australia - Wikipedia", "snippet": "", "timestamp": "2001-11-04T00:00:00", "url": "https://en.wikipedia.org/wiki/Australia", "meta_data": {"citation_domain_name": null, "client": "web", "images": ["https://upload.wikimedia.org/wikipedia/commons/thumb/8/88/Flag_of_Australia_%28converted%29.svg/1280px-Flag_of_Australia_%28converted%29.svg.png"]}, "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigational": false, "is_widget": false, "is_focused_web": false, "is_client_context": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false, "trust": {"level": 2, "name": "trusted", "description": "is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge"}}, {"name": "Portal:Geography/Featured article/28 - Wikipedia", "snippet": "Canberra is the capital city of Australia and with a population of just over 323,000 is Australia's largest inland city. Canberra was selected as the location of the nation's capital in 1908 as a compromise between Sydney and Melbourne and is unusual amongst Australian capital cities as an entirely purpose-built, planned city.", "timestamp": "2022-01-01T00:00:00", "url": "https://en.wikipedia.org/wiki/Portal:Geography/Featured_article/28", "meta_data": {"citation_domain_name": null, "client": "web", "images": []}, "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigational": false, "is_widget": false, "is_focused_web": false, "is_client_context": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false, "trust": {"level": 2, "name": "trusted", "description": "is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge"}}, {"name": "List of Australian capital cities - Wikipedia", "snippet": "There are eight capital cities in Australia, each of which functions as the seat of government for the state or territory in which it is located. One of these, Canberra, is also the national capital. Section 125 of the Constitution of Australia specified that the seat of the national government, that is, the national capital, would be in its own territory within New South Wales, at least 100 miles (161 km) from Sydney. The Constitution specified that until this national capital was ready, the...", "timestamp": "2005-12-05T00:00:00", "url": "https://en.wikipedia.org/wiki/List_of_Australian_capital_cities", "meta_data": {"citation_domain_name": null, "client": "web", "images": ["https://upload.wikimedia.org/wikipedia/commons/thumb/b/b6/Skylines_of_Sydney_CBD_seen_from_North_Sydney%2C_August_2022%2C_04.jpg/1280px-Skylines_of_Sydney_CBD_seen_from_North_Sydney%2C_August_2022%2C_04.jpg"]}, "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigational": false, "is_widget": false, "is_focused_web": false, "is_client_context": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false, "trust": {"level": 2, "name": "trusted", "description": "is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge"}}, {"name": "How Canberra Became the Capital of Australia", "snippet": "Wondering why Canberra, not Sydney or Melbourne, is the capital of Australia? Discover how it was chosen, what makes it unique, and why it\u2019s worth visiting.", "timestamp": "2025-05-29T00:00:00", "u