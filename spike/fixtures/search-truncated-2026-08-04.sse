event: message
data: {"backend_uuid": "cab3a882-c4e2-494b-bc19-64e6832108e7", "context_uuid": "c3aac086-ff19-4c5b-bfab-cd273d9b77ce", "uuid": "0e2853b4-0848-45c8-acd0-376969f75470", "frontend_context_uuid": "8d8a0336-1e5d-4c6a-a05b-981bd690aa90", "frontend_uuid": "0e2853b4-0848-45c8-acd0-376969f75470", "display_model": "pplx_pro", "user_selected_model": "pplx_pro", "mode": "COPILOT", "query_str": "what is the capital of Australia", "search_focus": "SearchFocus.INTERNET", "source": "default", "attachments": [], "read_write_token": "REDACTED", "thread_url_slug": "cab3a882-c4e2-494b-bc19-64e6832108e7", "gpt4": false, "text_completed": false, "blocks": [{"intended_usage": "workflow_root", "diff_block": {"field": "workflow_block", "patches": [{"op": "replace", "path": "/status", "value": "WORKFLOW_EXECUTING_STEPS"}, {"op": "add", "path": "/steps/1", "value": {"status": "WORKFLOW_PENDING", "title": "", "items": [{"id": "923a7f3a67ab4336bcc390fae8645a09", "type": "WORKFLOW_ITEM_TEXT", "payload": {"text_payload": {"text": "", "chunks": ["The capital of Australia is **Canberr"], "variant": "answer", "is_streaming": true}}, "display_mode": "WORKFLOW_ITEM_ALWAYS_EXPAND", "variant": "answer"}], "started_at": "", "completed_at": "", "unnest_items": true, "source_tier": "SOURCE_TIER_DEFAULT", "id": "923a7f3a67ab4336bcc390fae8645a09"}}]}}, {"intended_usage": "web_results", "diff_block": {"field": "web_result_block", "patches": [{"op": "replace", "path": "/web_results/0/snippet", "value": "Australia is the smallest continent and one of the largest countries on Earth, lying between the Pacific and Indian oceans in the Southern Hemisphere. Its capital city is Canberra, and its most important economic and cultural centers are Sydney and Melbourne."}, {"op": "add", "path": "/web_results/0/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/fc7ec0b1-5112-5246-bdc9-af830e2bbf8a/e91e73d4-022b-59db-9713-717a2a198855.jpg"]}}, {"op": "replace", "path": "/web_results/1/snippet", "value": "Canberra is the nation's capital, while its most populous cities are Sydney and Melbourne, each with a population of more than five million. ... CapitalCanberra 35\u00b018\u203229\u2033S 149\u00b007\u203228\u2033E\ufeff / \ufeff35.30806\u00b0S 149.12444\u00b0E"}, {"op": "add", "path": "/web_results/1/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": ["https://upload.wikimedia.org/wikipedia/commons/thumb/8/88/Flag_of_Australia_%28converted%29.svg/1280px-Flag_of_Australia_%28converted%29.svg.png"]}}, {"op": "replace", "path": "/web_results/2/snippet", "value": "Canberra (/\u02c8k\u00e6nbr\u0259/ ^\u24d8^ *KAN-br\u0259*; Ngunawal: *Kanbarra*) is the capital city of Australia and the largest population centre in the Australian Capital Territory. ... As of June 2025, Canberra's estimated population, including the whole of the ACT, was 484,630."}, {"op": "add", "path": "/web_results/2/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/2016896b-fa24-50f2-bfe7-41314e0cd9cc/01a84265-e09c-5682-92ce-681c89a1afe2.jpg"]}}, {"op": "replace", "path": "/web_results/3/snippet", "value": "The capital of Australia is Canberra. The city is located in the Australian Capital Territory, 150 kilometers inland from the country\u2019s southeast coast."}, {"op": "add", "path": "/web_results/3/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/bc23429f-9fe3-5ff9-a52e-eec36df5496d/e0fc49c2-5962-580a-acd6-7c74e5ad0f2a.jpg"]}}, {"op": "replace", "path": "/web_results/4/snippet", "value": "Discover Australia's capital city! Many people guess Sydney or Melbourne, but the answer might surprise you. Learn the fascinating history behind this choice."}, {"op": "add", "path": "/web_results/4/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": []}}, {"op": "replace", "path": "/web_results/5/snippet", "value": "Canberra Canberra, the capital city of Australia, is located in the southeastern part of the country, in the Australian Capital Territory (ACT). Unlike many national capitals, Canberra was specifically chosen and designed to be the country\u2019s capital, rather than being an existing city. ... While Canberra is the current capital of Australia, historically, other cities have served as the administrative center before its establishment. ... Population:Approximately 26 million (2023) Area:7,692,024..."}, {"op": "add", "path": "/web_results/5/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": []}}, {"op": "replace", "path": "/web_results/6/snippet", "value": "There are eight capital cities in Australia, each of which functions as the seat of government for the state or territory in which it is located. One of these, Canberra, is also the national capital. ... In 1927, the national capital was finally ready and the national government relocated from its former seat in Melbourne to Canberra within the Australian Capital Territory (or the Federal Capital Territory as it was known at the time). ... WALES VICTORIA TASMANIA \u25cfPerth \u25cfAdelaide \u25cfMelbourne..."}, {"op": "add", "path": "/web_results/6/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": ["https://upload.wikimedia.org/wikipedia/commons/thumb/b/b6/Skylines_of_Sydney_CBD_seen_from_North_Sydney%2C_August_2022%2C_04.jpg/1280px-Skylines_of_Sydney_CBD_seen_from_North_Sydney%2C_August_2022%2C_04.jpg"]}}, {"op": "replace", "path": "/web_results/7/snippet", "value": "You\u2019ve probably been asked \u201cWhat is the capital of Australia?\u201d more than once. The answer is Canberra \u2014 but the story behind that answer is a fascinating tale of political compromise, rivalries, and a purpose-built city. Official capital: Canberra \u00b7 Population of Canberra (2021): 484,630 \u00b7 Year named capital: 1913 \u00b7 Federal territory: Australian Capital [\u2026]"}, {"op": "add", "path": "/web_results/7/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": []}}, {"op": "replace", "path": "/web_results/8/snippet", "value": "Canberra city, which is the 8th most populous city in Australia, is the capital of the country. It covers an area of 314.4 square miles"}, {"op": "add", "path": "/web_results/8/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": []}}, {"op": "replace", "path": "/web_results/9/snippet", "value": "Neither Sydney nor Melbourne, Australia's capital is Canberra. Here's the story of how the country's capital was decided."}, {"op": "add", "path": "/web_results/9/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/4a549263-8a03-5f80-b7ef-6c10496d380c/d4b21e70-db22-5959-9b12-63fa6475155f.jpg"]}}]}}, {"intended_usage": "answer_tabs", "diff_block": {"field": "answer_tabs_block", "patches": [{"op": "replace", "path": "", "value": {"modes": [{"answer_mode_type": "ANSWER"}, {"answer_mode_type": "SOURCES"}, {"answer_mode_type": "IMAGE", "has_preview": false}], "reformulated_queries": []}}]}}, {"intended_usage": "sources_answer_mode", "diff_block": {"field": "sources_mode_block", "patches": [{"op": "replace", "path": "/web_results/0/snippet", "value": "Australia is the smallest continent and one of the largest countries on Earth, lying between the Pacific and Indian oceans in the Southern Hemisphere. Its capital city is Canberra, and its most important economic and cultural centers are Sydney and Melbourne."}, {"op": "add", "path": "/web_results/0/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/fc7ec0b1-5112-5246-bdc9-af830e2bbf8a/e91e73d4-022b-59db-9713-717a2a198855.jpg"]}}, {"op": "replace", "path": "/web_results/1/snippet", "value": "Canberra is the nation's capital, while its most populous cities are Sydney and Melbourne, each with a population of more than five million. ... CapitalCanberra 35\u00b018\u203229\u2033S 149\u00b007\u203228\u2033E\ufeff / \ufeff35.30806\u00b0S 149.12444\u00b0E"}, {"op": "add", "path": "/web_results/1/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": ["https://upload.wikimedia.org/wikipedia/commons/thumb/8/88/Flag_of_Australia_%28converted%29.svg/1280px-Flag_of_Australia_%28converted%29.svg.png"]}}, {"op": "replace", "path": "/web_results/2/snippet", "value": "Canberra (/\u02c8k\u00e6nbr\u0259/ ^\u24d8^ *KAN-br\u0259*; Ngunawal: *Kanbarra*) is the capital city of Australia and the largest population centre in the Australian Capital Territory. ... As of June 2025, Canberra's estimated population, including the whole of the ACT, was 484,630."}, {"op": "add", "path": "/web_results/2/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/2016896b-fa24-50f2-bfe7-41314e0cd9cc/01a84265-e09c-5682-92ce-681c89a1afe2.jpg"]}}, {"op": "replace", "path": "/web_results/3/snippet", "value": "The capital of Australia is Canberra. The city is located in the Australian Capital Territory, 150 kilometers inland from the country\u2019s southeast coast."}, {"op": "add", "path": "/web_results/3/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/bc23429f-9fe3-5ff9-a52e-eec36df5496d/e0fc49c2-5962-580a-acd6-7c74e5ad0f2a.jpg"]}}, {"op": "replace", "path": "/web_results/4/snippet", "value": "Discover Australia's capital city! Many people guess Sydney or Melbourne, but the answer might surprise you. Learn the fascinating history behind this choice."}, {"op": "add", "path": "/web_results/4/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": []}}, {"op": "replace", "path": "/web_results/5/snippet", "value": "Canberra Canberra, the capital city of Australia, is located in the southeastern part of the country, in the Australian Capital Territory (ACT). Unlike many national capitals, Canberra was specifically chosen and designed to be the country\u2019s capital, rather than being an existing city. ... While Canberra is the current capital of Australia, historically, other cities have served as the administrative center before its establishment. ... Population:Approximately 26 million (2023) Area:7,692,024..."}, {"op": "add", "path": "/web_results/5/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": []}}, {"op": "replace", "path": "/web_results/6/snippet", "value": "There are eight capital cities in Australia, each of which functions as the seat of government for the state or territory in which it is located. One of these, Canberra, is also the national capital. ... In 1927, the national capital was finally ready and the national government relocated from its former seat in Melbourne to Canberra within the Australian Capital Territory (or the Federal Capital Territory as it was known at the time). ... WALES VICTORIA TASMANIA \u25cfPerth \u25cfAdelaide \u25cfMelbourne..."}, {"op": "add", "path": "/web_results/6/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": ["https://upload.wikimedia.org/wikipedia/commons/thumb/b/b6/Skylines_of_Sydney_CBD_seen_from_North_Sydney%2C_August_2022%2C_04.jpg/1280px-Skylines_of_Sydney_CBD_seen_from_North_Sydney%2C_August_2022%2C_04.jpg"]}}, {"op": "replace", "path": "/web_results/7/snippet", "value": "You\u2019ve probably been asked \u201cWhat is the capital of Australia?\u201d more than once. The answer is Canberra \u2014 but the story behind that answer is a fascinating tale of political compromise, rivalries, and a purpose-built city. Official capital: Canberra \u00b7 Population of Canberra (2021): 484,630 \u00b7 Year named capital: 1913 \u00b7 Federal territory: Australian Capital [\u2026]"}, {"op": "add", "path": "/web_results/7/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": []}}, {"op": "replace", "path": "/web_results/8/snippet", "value": "Canberra city, which is the 8th most populous city in Australia, is the capital of the country. It covers an area of 314.4 square miles"}, {"op": "add", "path": "/web_results/8/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": []}}, {"op": "replace", "path": "/web_results/9/snippet", "value": "Neither Sydney nor Melbourne, Australia's capital is Canberra. Here's the story of how the country's capital was decided."}, {"op": "add", "path": "/web_results/9/meta_data", "value": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/4a549263-8a03-5f80-b7ef-6c10496d380c/d4b21e70-db22-5959-9b12-63fa6475155f.jpg"]}}]}}, {"intended_usage": "media_items", "diff_block": {"field": "media_block", "patches": [{"op": "replace", "path": "", "value": null}]}}], "message_mode": "STREAMING", "answer_modes": [{"answer_mode_type": "ANSWER"}, {"answer_mode_type": "SOURCES"}, {"answer_mode_type": "IMAGE", "has_preview": false}], "structured_answer_block_usages": ["workflow_root"], "reconnectable": true, "cursor": "06a71ed7-5a1a-7b33-8000-0c141823ad48", "classifier_results": {"mhe_predictions": {"nav_intent": false, "comet_nav_widget_combined_target": false}, "mhe_predictions_full": {"nav_intent": {"is_true": false, "probability": 0.0005531311, "threshold": 0.5}, "comet_nav_widget_combined_target": {"is_true": false, "probability": 0.0024719238, "threshold": 0.5}}}, "search_implementation_mode": "multi_step", "search_mode": "SEARCH", "status": "PENDING", "final_sse_message": false}

