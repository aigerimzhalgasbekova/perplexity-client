data: {"backend_uuid": "cab3a882-c4e2-494b-bc19-64e6832108e7", "context_uuid": "c3aac086-ff19-4c5b-bfab-cd273d9b77ce", "uuid": "0e2853b4-0848-45c8-acd0-376969f75470", "frontend_context_uuid": "8d8a0336-1e5d-4c6a-a05b-981bd690aa90", "frontend_uuid": "0e2853b4-0848-45c8-acd0-376969f75470", "display_model": "pplx_pro", "user_selected_model": "pplx_pro", "mode": "COPILOT", "query_str": "what is the capital of Australia", "search_focus": "SearchFocus.INTERNET", "source": "default", "attachments": [], "read_write_token": "REDACTED", "thread_url_slug": "cab3a882-c4e2-494b-bc19-64e6832108e7", "gpt4": false, "text_completed": false, "blocks": [{"intended_usage": "workflow_root", "diff_block": {"field": "workflow_block", "patches": [{"op": "add", "path": "/steps/0/items/1", "value": {"id": "prefill_search_web:item:0", "type": "WORKFLOW_ITEM_SOURCES", "payload": {"sources_payload": {"sources": [{"name": "Australia | History, Cities, Population, Capital, Map, & Facts", "snippet": "Australia is the smallest continent and one of the largest countries on Earth, lying between the Pacific and Indian oceans in the Southern Hemisphere. Its capital city is Canberra, and its most important economic and cultural centers are Sydney and Melbourne.", "url": "https://www.britannica.com/place/Australia", "trust": {"level": 2, "name": "trusted", "description": "is trusted for professionally edited general-reference and educational articles across history, science, culture, and other subjects"}}, {"name": "Australia - Wikipedia", "snippet": "", "url": "https://en.wikipedia.org/wiki/Australia", "trust": {"level": 2, "name": "trusted", "description": "is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge"}}, {"name": "Canberra - Wikipedia", "snippet": "", "url": "https://en.wikipedia.org/wiki/Canberra", "trust": {"level": 2, "name": "trusted", "description": "is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge"}}, {"name": "What is the Capital of Australia? - Mappr", "snippet": "The capital of Australia is Canberra. The city is located in the Australian Capital Territory, 150 kilometers inland from the country\u2019s southeast coast.", "url": "https://www.mappr.co/capital-cities/australia/"}, {"name": "What is the capital of Australia?", "snippet": "Discover Australia's capital city! Many people guess Sydney or Melbourne, but the answer might surprise you. Learn the fascinating history behind this choice.", "url": "https://www.vedantu.com/question-answer/what-is-the-capital-of-australia-692febb7fd13621f5a4ecf12"}, {"name": "What is the Capital of Australia? Canberra - Countryaah.com", "snippet": "", "url": "https://www.countryaah.com/australia-faqs/"}, {"name": "List of Australian capital cities - Wikipedia", "snippet": "", "url": "https://en.wikipedia.org/wiki/List_of_Australian_capital_cities", "trust": {"level": 2, "name": "trusted", "description": "is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge"}}, {"name": "What is the Capital of Australia? Canberra Facts & History - USAnalysis.org", "snippet": "You\u2019ve probably been asked \u201cWhat is the capital of Australia?\u201d more than once. The answer is Canberra \u2014 but the story behind that answer is a fascinating tale of political compromise, rivalries, and a purpose-built city. Official capital: Canberra \u00b7 Population of Canberra (2021): 484,630 \u00b7 Year named capital: 1913 \u00b7 Federal territory: Australian Capital [\u2026]", "url": "https://usanalysis.org/blog/what-is-the-capital-of-australia/"}, {"name": "What is the Capital of Australia? | Capital City of Australia", "snippet": "Canberra city, which is the 8th most populous city in Australia, is the capital of the country. It covers an area of 314.4 square miles", "url": "https://www.mapsofworld.com/answers/world/what-is-the-capital-of-australia/"}, {"name": "What is the capital of Australia? If you thought it ...", "snippet": "Neither Sydney nor Melbourne, Australia's capital is Canberra. Here's the story of how the country's capital was decided.", "url": "https://youtooproject.com/en/blog/australia-en/capital-of-australia-canberra/"}]}}}}]}}, {"intended_usage": "web_results", "diff_block": {"field": "web_result_block", "patches": [{"op": "replace", "path": "", "value": {"progress": "IN_PROGRESS", "web_results": [{"name": "Australia | History, Cities, Population, Capital, Map, & Facts", "snippet": "", "timestamp": "2026-06-08T00:00:00", "url": "https://www.britannica.com/place/Australia", "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigational": false, "is_widget": false, "is_focused_web": false, "is_client_context": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false, "trust": {"level": 2, "name": "trusted", "description": "is trusted for professionally edited general-reference and educational articles across history, science, culture, and other subjects"}}, {"name": "Australia - Wikipedia", "snippet": "", "timestamp": "2001-11-04T00:00:00", "url": "https://en.wikipedia.org/wiki/Australia", "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigational": false, "is_widget": false, "is_focused_web": false, "is_client_context": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false, "trust": {"level": 2, "name": "trusted", "description": "is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge"}}, {"name": "Canberra - Wikipedia", "snippet": "", "timestamp": "2001-08-27T00:00:00", "url": "https://en.wikipedia.org/wiki/Canberra", "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigational"