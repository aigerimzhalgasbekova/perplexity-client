data: {"backend_uuid": "9bf48727-3062-4a4c-998b-d798b74c78c0", "context_uuid": "5bc5dac0-b314-40e9-9fa2-bdc10acf2ad9", "uuid": "93aa05e0-a9b1-4729-ae23-bd4067bf9ad3", "frontend_context_uuid": "a72f0d34-4dd6-42fe-b4aa-ec5ab70a85d2", "frontend_uuid": "93aa05e0-a9b1-4729-ae23-bd4067bf9ad3", "text": "[{\"step_type\": \"INITIAL_QUERY\", \"content\": {\"goal_id\": null, \"query\": \"what is the capital of Australia and why is it not Sydney\"}, \"uuid\": \"\"}, {\"step_type\": \"SEARCH_WEB\", \"content\": {\"goal_id\": \"0\", \"queries\": [{\"engine\": \"web\", \"query\": \"capital of Australia\", \"limit\": 8}, {\"engine\": \"web\", \"query\": \"why is Canberra capital not Sydney\", \"limit\": 8}]}, \"uuid\": \"8641b306-7fe7-4cae-bebd-9ff4634c51aa\"}, {\"step_type\": \"SEARCH_RESULTS\", \"content\": {\"goal_id\": \"0\", \"web_results\": [{\"name\": \"Canberra - Wikipedia\", \"url\": \"https://en.wikipedia.org/wiki/Canberra\", \"snippet\": \"\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2001-08-27\", \"domain_name\": \"Wikimedia Foundation, Inc.\", \"published_date\": \"2001-08-27T00:00:00\"}, \"sitelinks\": null, \"trust\": {\"level\": 2, \"name\": \"trusted\", \"description\": \"is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge\", \"type_of_trust\": null}}, {\"name\": \"Australia | History, Cities, Population, Capital, Map, & Facts\", \"url\": \"https://www.britannica.com/place/Australia\", \"snippet\": \"Australia is the smallest continent and one of the largest countries on Earth, lying between the Pacific and Indian oceans in the Southern Hemisphere. Its capital city is Canberra, and its most important economic and cultural centers are Sydney and Melbourne.\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2026-06-08\", \"domain_name\": \"Encyclopedia Britannica\", \"description\": \"Australia is the smallest continent and one of the largest countries on Earth, lying between the Pacific and Indian oceans in the Southern Hemisphere. Its capital city is Canberra, and its most important economic and cultural centers are Sydney and Melbourne.\", \"published_date\": \"2026-06-08T00:00:00\"}, \"sitelinks\": null, \"trust\": {\"level\": 2, \"name\": \"trusted\", \"description\": \"is trusted for professionally edited general-reference and educational articles across history, science, culture, and other subjects\", \"type_of_trust\": null}}, {\"name\": \"What is the Capital of Australia? - Mappr\", \"url\": \"https://www.mappr.co/capital-cities/australia/\", \"snippet\": \"The capital of Australia is Canberra. The city is located in the Australian Capital Territory, 150 kilometers inland from the country\\u2019s southeast coast.\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2024-03-04\", \"domain_name\": \"Mappr\", \"description\": \"The capital of Australia is Canberra. The city is located in the Australian Capital Territory, 150 kilometers inland from the country\\u2019s southeast coast.\", \"published_date\": \"2024-03-04T00:00:00\"}, \"sitelinks\": null, \"trust\": null}, {\"name\": \"What is the Capital of Australia? Canberra Facts & History - USAnalysis.org\", \"url\": \"https://usanalysis.org/blog/what-is-the-capital-of-australia/\", \"snippet\": \"You\\u2019ve probably been asked \\u201cWhat is the capital of Australia?\\u201d more than once. The answer is Canberra \\u2014 but the story behind that answer is a fascinating tale of political compromise, rivalries, and a purpose-built city. Official capital: Canberra \\u00b7 Population of Canberra (2021): 484,630 \\u00b7 Year named capital: 1913 \\u00b7 Federal territory: Australian Capital [\\u2026]\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2026-07-16\", \"domain_name\": \"usanalysis.org\", \"description\": \"You\\u2019ve probably been asked \\u201cWhat is the capital of Australia?\\u201d more than once. The answer is Canberra \\u2014 but the story behind that answer is a fascinating tale of political compromise, rivalries, and a purpose-built city. Official capital: Canberra \\u00b7 Population of Canberra (2021): 484,630 \\u00b7 Year named capital: 1913 \\u00b7 Federal territory: Australian Capital [\\u2026]\", \"published_date\": \"2026-07-16T00:00:00\"}, \"sitelinks\": null, \"trust\": null}, {\"name\": \"Australia - Wikipedia\", \"url\": \"https://en.wikipedia.org/wiki/Australia\", \"snippet\": \"\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2001-11-04\", \"domain_name\": \"Wikimedia Foundation, Inc.\", \"published_date\": \"2001-11-04T00:00:00\"}, \"sitelinks\": null, \"trust\": {\"level\": 2, \"name\": \"trusted\", \"description\": \"is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge\", \"type_of_trust\": null}}, {\"name\": \"Portal:Geography/Featured article/28 - Wikipedia\", \"url\": \"https://en.wikipedia.org/wiki/Portal:Geography/Featured_article/28\", \"snippet\": \"\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2022-01-01\", \"domain_name\": \"en.wikipedia.org\", \"published_date\": \"2022-01-01T00:00:00\"}, \"sitelinks\": null, \"trust\": {\"level\": 2, \"name\": \"trusted\", \"description\": \"is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge\", \"type_of_trust\": null}}, {\"name\": \"List of Australian capital cities - Wikipedia\", \"url\": \"https://en.wikipedia.org/wiki/List_of_Australian_capital_cities\", \"snippet\": \"\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2005-12-05\", \"domain_name\": \"Wikimedia Foundation, Inc.\", \"published_date\": \"2005-12-05T00:00:00\"}, \"sitelinks\": null, \"trust\": {\"level\": 2, \"name\": \"trusted\", \"description\": \"is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge\", \"type_of_trust\": null}}, {\"name\": \"How Canberra Became the Capital of Australia\", \"url\": \"https://www.remitly.com/blog/en-au/lifestyle-culture/capital-of-australia/\", \"snippet\": \"Wondering why Canberra, not Sydney or Melbourne, is the capital of Australia? Discover how it was chosen, what makes it unique, and why it\\u2019s worth visiting.\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2025-05-29\", \"domain_name\": \"Beyond Borders by Remitly\", \"description\": \"Wondering why Canberra, not Sydney or Melbourne, is the capital of Australia? Discover how it was chosen, what makes it unique, and why it\\u2019s worth visiting.\", \"published_date\": \"2025-05-29T00:00:00\"}, \"sitelinks\": null, \"trust\": {\"level\": 2, \"name\": \"trusted\", \"description\": \"is trusted for official international money-transfer services, account support, fees, licensing, and corporate information\", \"type_of_trust\": null}}, {\"name\": \"Sydney isn't the capital of Australia!\", \"url\": \"https://ovolohotels.com/ovolo/blog/sydney-isnt-the-capital-of-australia/\", \"snippet\": \"Read about the capital of Australia, why it's not what you expected, and the many reasons you should definitely visit the beautiful country. Find out more!\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2015-09-30\", \"domain_name\": \"Ovolo Hotels\", \"description\": \"Read about the capital of Australia, why it's not what you expected, and the many reasons you should definitely visit the beautiful country. Find out more!\", \"published_date\": \"2015-09-30T00:00:00\"}, \"sitelinks\": null, \"trust\": null}, {\"name\": \"What Is The Capital Of Australia?\", \"url\": \"https://www.worldatlas.com/articles/what-is-the-capital-of-australia.html\", \"snippet\": \"Located at the Australian Capital Territory's northern end is Canberra, the capital and largest inland city of Australia.\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2018-06-27\", \"domain_name\": \"WorldAtlas\", \"description\": \"Located at the Australian Capital Territory's northern end is Canberra, the capital and largest inland city of Australia.\", \"published_date\": \"2018-06-27T00:00:00\"}, \"sitelinks\": null, \"trust\": null}, {\"name\": \"[Solved] Capital of Australia:\", \"url\": \"https://testbook.com/question-answer/capital-of-australia--69d4f1ac9e4bb2d6cb4f660b\", \"snippet\": \"The correct answer is Canberra. Key Points Canberra is the capital city of Australia, located in the southeastern part of the country within the Australian\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2026-07-15\", \"domain_name\": \"Testbook\", \"description\": \"The correct answer is Canberra. Key Points Canberra is the capital city of Australia, located in the southeastern part of the country within the Australian\", \"published_date\": \"2026-07-15T00:00:00\"}, \"sitelinks\": null, \"trust\": null}, {\"name\": \"Canberra | History, Map, Population, Climate, & Facts - Britannica\", \"url\": \"https://www.britannica.com/place/Canberra\", \"snippet\": \"Canberra, federal capital of the Commonwealth of Australia. It occupies part of the Australian Capital Territory, in southern Australia, and is about 150 miles (240 km) southwest of Sydney. Canberra lies astride the Molonglo River, which is a tributary of the Murrumbidgee River.\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2026-06-03\", \"domain_name\": \"Encyclopedia Britannica\", \"description\": \"Canberra, federal capital of the Commonwealth of Australia. It occupies part of the Australian Capital Territory, in southern Australia, and is about 150 miles (240 km) southwest of Sydney. Canberra lies astride the Molonglo River, which is a tributary of the Murrumbidgee River.\", \"published_date\": \"2026-06-03T00:00:00\"}, \"sitelinks\": null, \"trust\": {\"level\": 2, \"name\": \"trusted\", \"description\": \"is trusted for professionally edited general-reference and educational articles across history, science, culture, and other subjects\", \"type_of_trust\": null}}, {\"name\": \"Canberra: Discover the Capital City of Australia\", \"url\": \"https://imba.missouri.edu/capitol-of-australia-2998004720.html\", \"snippet\": \"When people think of Australia, images of the Sydney Opera House, the Great Barrier Reef, and the vast Outback often come to mind. However, the question \\\"what i\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"domain_name\": \"Imba Missouri Insights\", \"description\": \"When people think of Australia, images of the Sydney Opera House, the Great Barrier Reef, and the vast Outback often come to mind. However, the question \\\"what i\"}, \"sitelinks\": null, \"trust\": null}, {\"name\": \"What is the capital of Australia? If you thought it ...\", \"url\": \"https://youtooproject.com/en/blog/australia-en/capital-of-australia-canberra/\", \"snippet\": \"Neither Sydney nor Melbourne, Australia's capital is Canberra. Here's the story of how the country's capital was decided.\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2024-09-22\", \"domain_name\": \"Youtooproject\", \"description\": \"Neither Sydney nor Melbourne, Australia's capital is Canberra. Here's the story of how the country's capital was decided.\", \"published_date\": \"2024-09-22T00:00:00\"}, \"sitelinks\": null, \"trust\": null}, {\"name\": \"What is the capital of Australia?\", \"url\": \"https://www.vedantu.com/question-answer/what-is-the-capital-of-australia-692febb7fd13621f5a4ecf12\", \"snippet\": \"Discover Australia's capital city! Many people guess Sydney or Melbourne, but the answer might surprise you. Learn the fascinating history behind this choice.\", \"is_attachment\": false, \"is_navigational\": false, \"is_focused_web\": false, \"is_memory\": false, \"is_conversation_history\": false, \"is_conversation_summary\": false, \"tab_id\": null, \"meta_data\": {\"client\": \"web\", \"date\": \"2025-12-03\", \"domain_name\": \"vedantu.com\", \"description\": \"Discover Australia's capital city! Many people guess Sydney or Melbourne, but the answer might surprise you. Learn the fascinating history behind this choice.\", \"published_date\": \"2025-12-03T00:00:00\"}, \"sitelinks\": null, \"trust\": null}]}, \"uuid\": \"c52f6f8b-71d7-4fd8-83f3-b0453f36addd\"}, {\"step_type\": \"FINAL\", \"content\": {\"goal_id\": null, \"answer\": \"{\\\"answer\\\": \\\"The capital of Australia is **Canberra**, not Sydney.[2][3][12]\\\\n## Why Canberra, not Sydney?\\\\nCanberra was chosen as Australia\\\\u2019s capital in **1908** as a political compromise between the country\\\\u2019s two largest and most rivalrous cities: **Sydney** and **Melbourne**.[4][6][10][11]\\\\n\\\\nWhen Australia federated in 1901, both Sydney (in New South Wales) and Melbourne (in Victoria) wanted to be the national capital. The dispute was so intense it threatened the unity of the new nation.[13][14]\\\\n\\\\nThe solution, written into **Section 125 of the Australian Constitution**, was:\\\\n\\\\n- The capital would be located **within New South Wales** (giving Sydney\\\\u2019s state the honor)  \\\\n- But it had to be **at least 100 miles (161 km) from Sydney** (so Sydney wouldn\\\\u2019t dominate)  \\\\n- Until the new capital was ready, **Melbourne would serve as the temporary seat of government**[7][15]\\\\n\\\\nCanberra, a rural area between the two cities, was selected in 1908, formally founded in **1913**, and the federal government finally moved there from Melbourne in **1927**.[10][4][7][13]\\\\n## What makes Canberra unique?\\\\n- It\\\\u2019s a **purpose-built, planned city**, designed by American architect Walter Burley Griffin.[6][13]\\\\n- It\\\\u2019s Australia\\\\u2019s **largest inland city**, located in the **Australian Capital Territory (ACT)**, about 150\\\\u2013240 km southwest of Sydney.[3][12][10]\\\\n- Unlike most national capitals, it was never a major commercial or port city; it exists primarily as the **seat of government**.[14][13]\\\\nSo Sydney remains Australia\\\\u2019s largest and most internationally recognized city, but Canberra holds the official status of national capital as a deliberate compromise to balance regional rivalries.[11][15][2]\\\", \\\"web_results\\\": [{\\\"name\\\": \\\"Canberra - Wikipedia\\\", \\\"snippet\\\": \\\"\\\", \\\"timestamp\\\": \\\"2001-08-27T00:00:00\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Canberra\\\", \\\"meta_data\\\": {\\\"client\\\": \\\"web\\\", \\\"date\\\": \\\"2001-08-27\\\", \\\"citation_domain_name\\\": null, \\\"suffix\\\": null, \\\"domain_name\\\": \\\"Wikimedia Foundation, Inc.\\\", \\\"description\\\": null, \\\"images\\\": [\\\"https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/2016896b-fa24-50f2-bfe7-41314e0cd9cc/01a84265-e09c-5682-92ce-681c89a1afe2.jpg\\\"], \\\"published_date\\\": \\\"2001-08-27T00:00:00\\\", \\\"authors\\\": [\\\"Authority Control Databases\\\"]}, \\\"file_metadata\\\": null, \\\"is_attachment\\\": false, \\\"is_image\\\": false, \\\"is_code_interpreter\\\": false, \\\"is_knowledge_card\\\": false, \\\"is_navigational\\\": false, \\\"is_widget\\\": false, \\\"sitelinks\\\": null, \\\"is_focused_web\\\": false, \\\"is_client_context\\\": false, \\\"inline_entity_id\\\": null, \\\"is_memory\\\": false, \\\"is_conversation_history\\\": false, \\\"is_conversation_summary\\\": false, \\\"tab_id\\\": null, \\\"is_scrubbed\\\": null, \\\"is_hidden\\\": null, \\\"trust\\\": {\\\"level\\\": 2, \\\"name\\\": \\\"trusted\\\", \\\"description\\\": \\\"is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge\\\", \\\"type_of_trust\\\": null}, \\\"summary\\\": null, \\\"page_id\\\": null}, {\\\"name\\\": \\\"Australia | History, Cities, Population, Capital, Map, & Facts\\\", \\\"snippet\\\": \\\"Australia is the smallest continent and one of the largest countries on Earth, lying between the Pacific and Indian oceans in the Southern Hemisphere. Its capital city is Canberra, and its most important economic and cultural centers are Sydney and Melbourne.\\\", \\\"timestamp\\\": \\\"2026-06-08T00:00:00\\\", \\\"url\\\": \\\"https://www.britannica.com/place/Australia\\\", \\\"meta_data\\\": {\\\"client\\\": \\\"web\\\", \\\"date\\\": \\\"2026-06-08\\\", \\\"citation_domain_name\\\": null, \\\"suffix\\\": null, \\\"domain_name\\\": \\\"Encyclopedia Britannica\\\", \\\"description\\\": \\\"Australia is the smallest continent and one of the largest countries on Earth, lying between the Pacific and Indian oceans in the Southern Hemisphere. Its capital city is Canberra, and its most important economic and cultural centers are Sydney and Melbourne.\\\", \\\"images\\\": [\\\"https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/fc7ec0b1-5112-5246-bdc9-af830e2bbf8a/e91e73d4-022b-59db-9713-717a2a198855.jpg\\\"], \\\"published_date\\\": \\\"2026-06-08T00:00:00\\\", \\\"authors\\\": [\\\"Joseph Michael Powell\\\"]}, \\\"file_metadata\\\": null, \\\"is_attachment\\\": false, \\\"is_image\\\": false, \\\"is_code_interpreter\\\": false, \\\"is_knowledge_card\\\": false, \\\"is_navigational\\\": false, \\\"is_widget\\\": false, \\\"sitelinks\\\": null, \\\"is_focused_web\\\": false, \\\"is_client_context\\\": false, \\\"inline_entity_id\\\": null, \\\"is_memory\\\": false, \\\"is_conversation_history\\\": false, \\\"is_conversation_summary\\\": false, \\\"tab_id\\\": null, \\\"is_scrubbed\\\": null, \\\"is_hidden\\\": null, \\\"trust\\\": {\\\"level\\\": 2, \\\"name\\\": \\\"trusted\\\", \\\"description\\\": \\\"is trusted for professionally edited general-reference and educational articles across history, science, culture, and other subjects\\\", \\\"type_of_trust\\\": null}, \\\"summary\\\": null, \\\"page_id\\\": null}, {\\\"name\\\": \\\"What is the Capital of Australia? - Mappr\\\", \\\"snippet\\\": \\\"The capital of Australia is Canberra. The city is located in the Australian Capital Territory, 150 kilometers inland from the country\\\\u2019s southeast coast.\\\", \\\"timestamp\\\": \\\"2024-03-04T00:00:00\\\", \\\"url\\\": \\\"https://www.mappr.co/capital-cities/australia/\\\", \\\"meta_data\\\": {\\\"client\\\": \\\"web\\\", \\\"date\\\": \\\"2024-03-04\\\", \\\"citation_domain_name\\\": null, \\\"suffix\\\": null, \\\"domain_name\\\": \\\"Mappr\\\", \\\"description\\\": \\\"The capital of Australia is Canberra. The city is located in the Australian Capital Territory, 150 kilometers inland from the country\\\\u2019s southeast coast.\\\", \\\"images\\\": [\\\"https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/bc23429f-9fe3-5ff9-a52e-eec36df5496d/e0fc49c2-5962-580a-acd6-7c74e5ad0f2a.jpg\\\"], \\\"published_date\\\": \\\"2024-03-04T00:00:00\\\", \\\"authors\\\": [\\\"Mappr Team\\\"]}, \\\"file_metadata\\\": null, \\\"is_attachment\\\": false, \\\"is_image\\\": false, \\\"is_code_interpreter\\\": false, \\\"is_knowledge_card\\\": false, \\\"is_navigational\\\": false, \\\"is_widget\\\": false, \\\"sitelinks\\\": null, \\\"is_focused_web\\\": false, \\\"is_client_context\\\": false, \\\"inline_entity_id\\\": null, \\\"is_memory\\\": false, \\\"is_conversation_history\\\": false, \\\"is_conversation_summary\\\": false, \\\"tab_id\\\": null, \\\"is_scrubbed\\\": null, \\\"is_hidden\\\": null, \\\"trust\\\": null, \\\"summary\\\": null, \\\"page_id\\\": null}, {\\\"name\\\": \\\"What is the Capital of Australia? Canberra Facts & History - USAnalysis.org\\\", \\\"snippet\\\": \\\"You\\\\u2019ve probably been asked \\\\u201cWhat is the capital of Australia?\\\\u201d more than once. The answer is Canberra \\\\u2014 but the story behind that answer is a fascinating tale of political compromise, rivalries, and a purpose-built city. Official capital: Canberra \\\\u00b7 Population of Canberra (2021): 484,630 \\\\u00b7 Year named capital: 1913 \\\\u00b7 Federal territory: Australian Capital [\\\\u2026]\\\", \\\"timestamp\\\": \\\"2026-07-16T00:00:00\\\", \\\"url\\\": \\\"https://usanalysis.org/blog/what-is-the-capital-of-australia/\\\", \\\"meta_data\\\": {\\\"client\\\": \\\"web\\\", \\\"date\\\": \\\"2026-07-16\\\", \\\"citation_domain_name\\\": null, \\\"suffix\\\": null, \\\"domain_name\\\": \\\"usanalysis.org\\\", \\\"description\\\": \\\"You\\\\u2019ve probably been asked \\\\u201cWhat is the capital of Australia?\\\\u201d more than once. The answer is Canberra \\\\u2014 but the story behind that answer is a fascinating tale of political compromise, rivalries, and a purpose-built city. Official capital: Canberra \\\\u00b7 Population of Canberra (2021): 484,630 \\\\u00b7 Year named capital: 1913 \\\\u00b7 Federal territory: Australian Capital [\\\\u2026]\\\", \\\"images\\\": [], \\\"published_date\\\": \\\"2026-07-16T00:00:00\\\", \\\"authors\\\": [\\\"Liam Benjamin Mercer\\\"]}, \\\"file_metadata\\\": null, \\\"is_attachment\\\": false, \\\"is_image\\\": false, \\\"is_code_interpreter\\\": false, \\\"is_knowledge_card\\\": false, \\\"is_navigational\\\": false, \\\"is_widget\\\": false, \\\"sitelinks\\\": null, \\\"is_focused_web\\\": false, \\\"is_client_context\\\": false, \\\"inline_entity_id\\\": null, \\\"is_memory\\\": false, \\\"is_conversation_history\\\": false, \\\"is_conversation_summary\\\": false, \\\"tab_id\\\": null, \\\"is_scrubbed\\\": null, \\\"is_hidden\\\": null, \\\"trust\\\": null, \\\"summary\\\": null, \\\"page_id\\\": null}, {\\\"name\\\": \\\"Australia - Wikipedia\\\", \\\"snippet\\\": \\\"\\\", \\\"timestamp\\\": \\\"2001-11-04T00:00:00\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Australia\\\", \\\"meta_data\\\": {\\\"client\\\": \\\"web\\\", \\\"date\\\": \\\"2001-11-04\\\", \\\"citation_domain_name\\\": null, \\\"suffix\\\": null, \\\"domain_name\\\": \\\"Wikimedia Foundation, Inc.\\\", \\\"description\\\": null, \\\"images\\\": [\\\"https://upload.wikimedia.org/wikipedia/commons/thumb/8/88/Flag_of_Australia_%28converted%29.svg/1280px-Flag_of_Australia_%28converted%29.svg.png\\\"], \\\"published_date\\\": \\\"2001-11-04T00:00:00\\\", \\\"authors\\\": [\\\"Authority Control Databases\\\"]}, \\\"file_metadata\\\": null, \\\"is_attachment\\\": false, \\\"is_image\\\": false, \\\"is_code_interpreter\\\": false, \\\"is_knowledge_card\\\": false, \\\"is_navigational\\\": false, \\\"is_widget\\\": false, \\\"sitelinks\\\": null, \\\"is_focused_web\\\": false, \\\"is_client_context\\\": false, \\\"inline_entity_id\\\": null, \\\"is_memory\\\": false, \\\"is_conversation_history\\\": false, \\\"is_conversation_summary\\\": false, \\\"tab_id\\\": null, \\\"is_scrubbed\\\": null, \\\"is_hidden\\\": null, \\\"trust\\\": {\\\"level\\\": 2, \\\"name\\\": \\\"trusted\\\", \\\"description\\\": \\\"is trusted for broad, cited secondary-reference information across education, science, history, and general knowledge\\\", \\\"type_of_trust\\\": null}, \\\"summary\\\": null, \\\"page_id\\\": null}, {\\\"name\\\": \\\"Portal:Geography/Featured article/28 - Wikipedia\\\", \\\"snippet\\\": \\\"Canberra is the capital city of Australia and with a population of just over 323,000 is Australia's largest inland city. Canberra was selected as the location of the nation's capital in 1908 as a compromise between Sydney and Melbourne and is unusual amongst Australian capital cities as an entirely purpose-built, planned city.\\\", \\\"timestamp\\\": \\\"2022-01-01T00:00:00\\\", \\\"url\\\": \\\"https://en.wikipedia.org/wiki/Portal:Geography/Featured_article/28\\\", \\\"meta_data\\\": {\\\"cli