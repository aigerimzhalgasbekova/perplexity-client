.net/thumbnails/06e6c331-5874-5df7-9ee2-c82eb3e78a0e/14b98223-512e-542b-80cb-2a7ef4373de1.jpg"]}, "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigational": false, "is_widget": false, "is_focused_web": false, "is_client_context": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false}, {"name": "[Solved] Capital of Australia:", "snippet": "The correct answer is Canberra. Key Points Canberra is the capital city of Australia, located in the southeastern part of the country within the Australian", "timestamp": "2026-07-15T00:00:00", "url": "https://testbook.com/question-answer/capital-of-australia--69d4f1ac9e4bb2d6cb4f660b", "meta_data": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/f309bc4e-aeac-5bd3-ad4d-7de55575fc9e/33194e52-4b5c-52d4-b6f9-95270b376552.jpg"]}, "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigational": false, "is_widget": false, "is_focused_web": false, "is_client_context": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false}, {"name": "Canberra | History, Map, Population, Climate, & Facts - Britannica", "snippet": "Canberra, federal capital of the Commonwealth of Australia. It occupies part of the Australian Capital Territory, in southern Australia, and is about 150 miles (240 km) southwest of Sydney. Canberra lies astride the Molonglo River, which is a tributary of the Murrumbidgee River.", "timestamp": "2026-06-03T00:00:00", "url": "https://www.britannica.com/place/Canberra", "meta_data": {"citation_domain_name": null, "client": "web", "images": ["https://d2u1z1lopyfwlx.cloudfront.net/thumbnails/9eb65d32-1d6b-59a5-8572-bd4afa1dbb68/e91e73d4-022b-59db-9713-717a2a198855.jpg"]}, "is_attachment": false, "is_image": false, "is_code_interpreter": false, "is_knowledge_card": false, "is_navigat