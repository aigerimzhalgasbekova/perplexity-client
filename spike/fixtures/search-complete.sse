ame": "Sydney isn't the capital of Australia!", "snippet": "Read about the capital of Australia, why it's not what you expected, and the many reasons you should definitely visit the beautiful country. Find out more!", "url": "https://ovolohotels.com/ovolo/blog/sydney-isnt-the-capital-of-australia/", "meta_data": {"client": "web", "date": "2015-09-30", "domain_name": "Ovolo Hotels", "description": "Read about the capital of Australia, why it's not what you expected, and the many reasons you should definitely visit the beautiful country. Find out more!", "published_date": "2015-09-30T00:00:00"}, "is_attachment": false, "is_navigational": false, "is_focused_web": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false}, {"name": "What Is The Capital Of Australia?", "snippet": "Located at the Australian Capital Territory's northern end is Canberra, the capital and largest inland city of Australia.", "url": "https://www.worldatlas.com/articles/what-is-the-capital-of-australia.html", "meta_data": {"client": "web", "date": "2018-06-27", "domain_name": "WorldAtlas", "description": "Located at the Australian Capital Territory's northern end is Canberra, the capital and largest inland city of Australia.", "published_date": "2018-06-27T00:00:00"}, "is_attachment": false, "is_navigational": false, "is_focused_web": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false}, {"name": "[Solved] Capital of Australia:", "snippet": "The correct answer is Canberra. Key Points Canberra is the capital city of Australia, located in the southeastern part of the country within the Australian", "url": "https://testbook.com/question-answer/capital-of-australia--69d4f1ac9e4bb2d6cb4f660b", "meta_data": {"client": "web", "date": "2026-07-15", "domain_name": "Testbook", "description": "The correct answer is Canberra. Key Points Canberra is the capital city of Australia, located in the southeastern part of the country within the Australian", "published_date": "2026-07-15T00:00:00"}, "is_attachment": false, "is_navigational": false, "is_focused_web": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false}, {"name": "Canberra | History, Map, Population, Climate, & Facts - Britannica", "snippet": "Canberra, federal capital of the Commonwealth of Australia. It occupies part of the Australian Capital Territory, in southern Australia, and is about 150 miles (240 km) southwest of Sydney. Canberra lies astride the Molonglo River, which is a tributary of the Murrumbidgee River.", "url": "https://www.britannica.com/place/Canberra", "meta_data": {"client": "web", "date": "2026-06-03", "domain_name": "Encyclopedia Britannica", "description": "Canberra, federal capital of the Commonwealth of Australia. It occupies part of the Australian Capital Territory, in southern Australia, and is about 150 miles (240 km) southwest of Sydney. Canberra lies astride the Molonglo River, which is a tributary of the Murrumbidgee River.", "published_date": "2026-06-03T00:00:00"}, "is_attachment": false, "is_navigational": false, "is_focused_web": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false, "trust": {"level": 2, "name": "trusted", "description": "is trusted for professionally edited general-reference and educational articles across history, science, culture, and other subjects"}}, {"name": "Canberra: Discover the Capital City of Australia", "snippet": "When people think of Australia, images of the Sydney Opera House, the Great Barrier Reef, and the vast Outback often come to mind. However, the question \"what i", "url": "https://imba.missouri.edu/capitol-of-australia-2998004720.html", "meta_data": {"client": "web", "domain_name": "Imba Missouri Insights", "description": "When people think of Australia, images of the Sydney Opera House, the Great Barrier Reef, and the vast Outback often come to mind. However, the question \"what i"}, "is_attachment": false, "is_navigational": false, "is_focused_web": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false}, {"name": "What is the capital of Australia? If you thought it ...", "snippet": "Neither Sydney nor Melbourne, Australia's capital is Canberra. Here's the story of how the country's capital was decided.", "url": "https://youtooproject.com/en/blog/australia-en/capital-of-australia-canberra/", "meta_data": {"client": "web", "date": "2024-09-22", "domain_name": "Youtooproject", "description": "Neither Sydney nor Melbourne, Australia's capital is Canberra. Here's the story of how the country's capital was decided.", "published_date": "2024-09-22T00:00:00"}, "is_attachment": false, "is_navigational": false, "is_focused_web": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false}, {"name": "What is the capital of Australia?", "snippet": "Discover Australia's capital city! Many people guess Sydney or Melbourne, but the answer might surprise you. Learn the fascinating history behind this choice.", "url": "https://www.vedantu.com/question-answer/what-is-the-capital-of-australia-692febb7fd13621f5a4ecf12", "meta_data": {"client": "web", "date": "2025-12-03", "domain_name": "vedantu.com", "description": "Discover Australia's capital city! Many people guess Sydney or Melbourne, but the answer might surprise you. Learn the fascinating history behind this choice.", "published_date": "2025-12-03T00:00:00"}, "is_attachment": false, "is_navigational": false, "is_focused_web": false, "is_memory": false, "is_conversation_history": false, "is_conversation_summary": false}]}}}], "started_at": "", "completed_at": "", "icon": "search", "source_tier": "SOURCE_TIER_DEFAULT", "id": "4d1d0f1b-75f1-4510-bf9a-d53478e52c35"}], "snapshots": []}}]}}, {"intended_usage": "sources_answer_mode", "diff_block": {"field": "sources_mode_block", "patches": [{"op": "replace", "path": "/progress", "value